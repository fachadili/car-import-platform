generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  clientRequests   Request[] @relation("ClientRequests")
  importerRequests Request[] @relation("ImporterRequests")
}

model Request {
  id         Int   @id @default(autoincrement())
  clientId   Int
  importerId Int?

  client   User  @relation("ClientRequests", fields: [clientId], references: [id])
  importer User? @relation("ImporterRequests", fields: [importerId], references: [id])
}
